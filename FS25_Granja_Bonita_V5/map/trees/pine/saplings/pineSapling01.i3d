<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="pineSapling01" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="4" filename="$data/shaders/placeableShader.xml" />
    <File fileId="1" filename="../pineBranch_diffuse.png" />
    <File fileId="3" filename="../pineBranch_fmask.png" />
    <File fileId="2" filename="../pineBranch_normal.png" />
  </Files>

  <Materials>
    <Material name="pineBranch_mat" materialId="1" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="pineSapling01.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="pineSapling01" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="50" nodeId="1">
      <Shape name="branches" shapeId="2" castsShadows="true" receiveShadows="true" doubleSided="true" materialIds="1" clipDistance="50" nodeId="2"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
